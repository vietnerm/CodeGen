{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeGen function spec (1 chức năng CRUD)",
  "description": "Định dạng spec/<SYS>/<SUB>/<FID>.yaml mà AI được phép tạo. Generator kiểm tra thêm các luật chéo (codemap tồn tại, quan hệ, SQL).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module",
    "schema",
    "function",
    "entity",
    "actions"
  ],
  "properties": {
    "module": {
      "type": "string",
      "pattern": "^[A-Z]{2}[A-Z0-9]{2}$"
    },
    "schema": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2}[A-Z0-9]{2}_[0-9]{4}$"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "type": "string"
        },
        "sort": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "pk",
        "fields"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string"
        },
        "pk": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "profiles": {
          "type": "array",
          "items": {
            "enum": [
              "tenant",
              "owner_unit",
              "audit",
              "versioned"
            ]
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "label"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$"
              },
              "type": {
                "enum": [
                  "TEXT",
                  "INT",
                  "BIGINT",
                  "DECIMAL",
                  "DATE",
                  "TIMESTAMP",
                  "BOOL"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4000
              },
              "precision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 38
              },
              "scale": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "nullable": {
                "type": "boolean"
              },
              "default": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "enum": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pattern": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "codemap": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "example": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "search": {
                "enum": [
                  "eq",
                  "like"
                ]
              },
              "description": {
                "type": "string"
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cols",
          "parent",
          "on_delete"
        ],
        "properties": {
          "cols": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "parent": {
            "type": "string",
            "pattern": "^[A-Z]{2}[A-Z0-9]{2}_[0-9]{4}$"
          },
          "on_delete": {
            "enum": [
              "RESTRICT",
              "CASCADE",
              "NULLIFY"
            ]
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "enum": [
          "SEARCH",
          "GET",
          "CREATE",
          "UPDATE",
          "DELETE"
        ]
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "name",
          "description"
        ],
        "properties": {
          "phase": {
            "enum": [
              "VALIDATE",
              "BEFORE_SAVE",
              "AFTER_SAVE"
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]{2,60}$"
          },
          "actions": {
            "type": "array",
            "items": {
              "enum": [
                "CREATE",
                "UPDATE",
                "DELETE"
              ]
            }
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
