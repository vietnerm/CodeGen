<!doctype html>
<!-- SINH TỰ ĐỘNG bởi CodeGen — KHÔNG SỬA TAY -->
<html lang="vi">
<head>
  <meta charset="utf-8">
  <title>{{ project.title }}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta20/dist/css/tabler.min.css">
</head>
<body>
  <div class="container-xl py-4">
    <h1>{{ project.title }}</h1>
    <p class="text-muted">API: <a href="/openapi/openapi.yaml">openapi.yaml</a> · <a href="/docs/index.md">tài liệu</a></p>
    <div id="app"></div>
  </div>
  <script type="module">
    import { core } from '/js/core.js';
    import { renderLogin } from '/js/page.js';
    const app = document.getElementById('app');
    const tree = (items) => '<ul>' + items.map((n) => '<li>' + (n.url ? `<a href="${n.url}">${n.function_id} · ${n.function_name}</a>`
      : `${n.function_id} · ${n.function_name}`) + (n.children.length ? tree(n.children) : '') + '</li>').join('') + '</ul>';
    const start = () => core.menu().then((m) => { app.innerHTML = tree(m); })
      .catch((e) => (e.status === 401 ? renderLogin(app, start) : (app.textContent = e.message)));
    core.token ? start() : renderLogin(app, start);
  </script>
</body>
</html>
